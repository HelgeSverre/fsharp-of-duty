<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Embedded into the Windows apphost; ignored on other platforms. -->
    <ApplicationIcon>../../packaging/icon.ico</ApplicationIcon>
    <!-- Published builds are one self-contained executable. Native libraries
         (GLFW, OpenAL Soft) ride inside it and self-extract; content files
         like servers.json stay loose beside it on purpose, so players can
         read and edit them. No trimming: F# + Silk.NET reflection is
         trim-hostile and the size win is not worth broken rendering. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Ironsight.Core/Ironsight.Core.fsproj" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenAL" Version="2.23.0" />
    <!-- Bundles OpenAL Soft natives so published builds have audio on systems
         without a system OpenAL (notably Windows). -->
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- The canonical server list ships beside the executable; the repo root
         copy is the single source of truth (and the PR target). -->
    <Content Include="../../servers.json" Link="servers.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Settings.fs" />
    <Compile Include="MapStore.fs" />
    <Compile Include="ServerDirectory.fs" />
    <Compile Include="Menu.fs" />
    <Compile Include="SettingsUi.fs" />
    <Compile Include="Input.fs" />
    <Compile Include="GlUtil.fs" />
    <Compile Include="Shaders.fs" />
    <Compile Include="NetworkClient.fs" />
    <Compile Include="OnlineWorld.fs" />
    <Compile Include="RenderInterpolation.fs" />
    <Compile Include="Hud.fs" />
    <Compile Include="Particles.fs" />
    <Compile Include="Audio.fs" />
    <Compile Include="Renderer.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
</Project>
