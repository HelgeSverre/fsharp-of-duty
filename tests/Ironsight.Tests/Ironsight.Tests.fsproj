<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Ironsight.Core/Ironsight.Core.fsproj" />
    <ProjectReference Include="../../src/Ironsight.Server/Ironsight.Server.fsproj" />
    <ProjectReference Include="../../src/Ironsight/Ironsight.fsproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- Collections run serially: several modules mutate process-global env
         vars (IRONSIGHT_LEVEL, IRONSIGHT_HOME) and would race in parallel. -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="TestKit.fs" />
    <Compile Include="CoreTests.fs" />
    <Compile Include="GeometryTests.fs" />
    <Compile Include="CombatTests.fs" />
    <Compile Include="AiTests.fs" />
    <Compile Include="ScriptTests.fs" />
    <Compile Include="SettingsTests.fs" />
    <Compile Include="ClientTests.fs" />
    <Compile Include="ServerTests.fs" />
    <Compile Include="MatchScript.fs" />
    <Compile Include="MapFileTests.fs" />
    <Compile Include="IntegrationTests.fs" />
  </ItemGroup>
</Project>
